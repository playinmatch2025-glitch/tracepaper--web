// Builds thousands of short-lived strings; almost all of them are garbage.
var keep = "he" + "llo";
var s = "";
for (var i = 0; i < 3000; i = i + 1) {
  s = s + "a";
}
print keep;         // expect: hello
var t = "";
for (var j = 0; j < 200; j = j + 1) { t = "x" + "y" + "z" + keep; }
print t;            // expect: xyzhello
